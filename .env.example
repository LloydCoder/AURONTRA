# Aurontra environment template
# Copy to .env and configure values for your environment. Never commit .env.

APP_NAME=Aurontra
VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

# Secure defaults. Do not enable the business data plane until tenant-scoped persistence is implemented.
AUTH_MODE=required
DATA_PLANE_ENABLED=False
DB_SCHEMA_REVISION=0009_threat_findings
TEST_MODE=False
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
MAX_REQUEST_BODY_BYTES=1048576

# Endpoint agents use Platform-approved DPoP-bound access tokens. Disabled by default.
AGENT_AUTH_ENABLED=False
AGENT_JWKS_URL=
AGENT_JWT_ISSUER=
AGENT_JWT_AUDIENCE=
AGENT_PUBLIC_ORIGIN=
AGENT_DPOP_MAX_AGE_SECONDS=60
AGENT_CLOCK_SKEW_SECONDS=30
AGENT_ACCESS_TOKEN_MAX_TTL_SECONDS=600
AGENT_REPLAY_RETENTION_SECONDS=300

# Governed actions call the official Tinlance Agent Platform SDK (API 1.1).
# Leave disabled until the reviewed Platform/TSIC contract and deployment are configured.
AGENT_PLATFORM_ENABLED=False
AGENT_PLATFORM_BASE_URL=
AGENT_PLATFORM_BEARER_TOKEN=
AGENT_PLATFORM_TENANT_ID=
AGENT_PLATFORM_SUBJECT_ID=
AGENT_PLATFORM_AGENT_ID=
AGENT_PLATFORM_TASK_ID=
AGENT_PLATFORM_API_VERSION=1.1
AGENT_PLATFORM_TIMEOUT_SECONDS=10
AGENT_PLATFORM_ALLOW_INSECURE_HTTP=False

DATABASE_URL=sqlite+aiosqlite:///./aurontra_dev.db
# Production should use PostgreSQL with TLS and managed credentials:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/aurontra

REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=["http://localhost:3000"]

ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY=claude-sonnet-4-6
LLM_FALLBACK=llama3-70b-8192
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_INPUT_CHARS=6000
LLM_MAX_OUTPUT_CHARS=2000

THREATFADE_URL=
FUSIONOPS_URL=
RECONOS_URL=
BUGFLOW_URL=
FDSE_URL=
HEZCAST_URL=
TWINGUARD_URL=
FADEFORGE_URL=
FADEFORGE_API_KEY=
AI_SHIELD_URL=
KALEVIO_URL=
KALEVIO_API_KEY=
OLVRIX_URL=
OLVRIX_BRIDGE_KEY=
FADEREACH_URL=
FADEREACH_API_KEY=
BRIDGE_TIMEOUT=5

LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=247127
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_STARTER_VARIANT_ID=
LS_BUSINESS_VARIANT_ID=
LS_ENTERPRISE_VARIANT_ID=
LS_CHECKOUT_BASE_URL=

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

RESEND_API_KEY=
EMAIL_FROM=

RESILIENCE_WARN_THRESHOLD=60
RESILIENCE_CRITICAL_THRESHOLD=40
PREDICTION_HORIZON_HOURS=72

# Safe remediation remains disabled until exact Platform tool registrations and
# tenant-scoped postcondition verifiers are provisioned and tested.
REMEDIATION_SUBMISSION_ENABLED=False

# Telemetry provenance and retention
TELEMETRY_MAX_AGE_SECONDS=300
TELEMETRY_FUTURE_SKEW_SECONDS=30
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_MAX_EVENTS_PER_MINUTE=120
