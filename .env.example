# ═══════════════════════════════════════════════════════════════════
# ResilientAI — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════════

# App
APP_NAME=ResilientAI
VERSION=0.1.0
DEBUG=False

# Database — use PostgreSQL in production
DATABASE_URL=postgresql+asyncpg://user:pass@localhost/resilientai
# For local dev with SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./resilientai_dev.db

# Redis
REDIS_URL=redis://localhost:6379

# CORS — add your frontend domain
ALLOWED_ORIGINS=["http://localhost:3000","https://resilientai.tinlance.com"]

# ── LLM Gateway ──────────────────────────────────────────────────────
# Layer 1: Claude (primary)
ANTHROPIC_API_KEY=sk-ant-...
LLM_PRIMARY=claude-sonnet-4-6

# Layer 2: Grok via Groq (fallback)
GROQ_API_KEY=gsk_...
LLM_FALLBACK=llama3-70b-8192

# ── Tinlance Infrastructure Bridges ──────────────────────────────────
# AWS EC2 Stockholm (13.50.16.19) — FusionOps + ThreatFade already live
THREATFADE_URL=http://13.50.16.19:8000
FUSIONOPS_URL=http://13.50.16.19:8001
RECONOS_URL=
BUGFLOW_URL=
BRIDGE_TIMEOUT=10

# ── LemonSqueezy Billing (Store 247127) ──────────────────────────────
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=247127
LEMONSQUEEZY_WEBHOOK_SECRET=
# Get these from your LemonSqueezy store variant IDs
LS_STARTER_VARIANT_ID=
LS_BUSINESS_VARIANT_ID=
LS_ENTERPRISE_VARIANT_ID=
LS_CHECKOUT_BASE_URL=https://resilientai.lemonsqueezy.com/checkout

# ── Auth (Clerk) ──────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@resilientai.tinlance.com

# ── Resilience Scoring Thresholds ────────────────────────────────────
RESILIENCE_WARN_THRESHOLD=60
RESILIENCE_CRITICAL_THRESHOLD=40
PREDICTION_HORIZON_HOURS=72

# ══════════════════════════════════════════════════════════════════
# ECOSYSTEM BRIDGES — Set URL to activate each bridge automatically
# ══════════════════════════════════════════════════════════════════

# ── WIRED (live on AWS EC2 Stockholm 13.50.16.19) ─────────────────
THREATFADE_URL=http://13.50.16.19:8000
FUSIONOPS_URL=http://13.50.16.19:8001

# ── ENV-ONLY (code ready, set URL to activate) ────────────────────
RECONOS_URL=                          # ReconOS OFE — device topology + temporal correlation
BUGFLOW_URL=                          # BugFlow Elite v6 — surface change detection
AI_SHIELD_URL=http://13.50.16.19:8002 # AI Shield — Parliament Ensemble security incidents

# ── SPRINT 7 (deploy product first, then set URL) ─────────────────
FDSE_URL=                             # FDSE Toolkit v2 — playbook library + credential scanner
HEZCAST_URL=                          # HezCast Engine — incident comms + report distribution
TWINGUARD_URL=                        # TwinGuard — AI containment verdicts
FADEFORGE_URL=                        # FadeForge AI — adversary profiles + red team patterns
FADEFORGE_API_KEY=                    # FadeForge API key (Estonian OÜ — separate auth)

# ── SPRINT 8 (deploy product first, then set URL) ─────────────────
KALEVIO_URL=                          # KalevioAI — compliance gaps → remediation tickets
KALEVIO_API_KEY=                      # KalevioAI API key
OLVRIX_URL=                           # Olvrix Platform — client events → ResilientAI tickets
OLVRIX_BRIDGE_KEY=                    # Olvrix bridge key (from Olvrix .env RESILIENTAI_API_KEY)
FADEREACH_URL=                        # FadeReach — trial signups → nurture + proof points
FADEREACH_API_KEY=                    # FadeReach API key
