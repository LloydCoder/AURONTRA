# Aurontra environment template
# Copy to .env and configure values for your environment. Never commit .env.
# Secrets and external integration endpoints are intentionally blank by default.

APP_NAME=Aurontra
VERSION=0.1.0
DEBUG=False

# Local development database. Use PostgreSQL with TLS and managed credentials in production.
DATABASE_URL=sqlite+aiosqlite:///./aurontra_dev.db
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/aurontra

REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=["http://localhost:3000"]

# LLM gateway; optional. Blank credentials must remain on the offline fallback.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY=claude-sonnet-4-6
LLM_FALLBACK=llama3-70b-8192

# Tinlance ecosystem integrations.
# Configure verified HTTPS service URLs and scoped credentials per environment.
THREATFADE_URL=
FUSIONOPS_URL=
RECONOS_URL=
BUGFLOW_URL=
FDSE_URL=
HEZCAST_URL=
TWINGUARD_URL=
FADEFORGE_URL=
FADEFORGE_API_KEY=
AI_SHIELD_URL=
KALEVIO_URL=
KALEVIO_API_KEY=
OLVRIX_URL=
OLVRIX_BRIDGE_KEY=
FADEREACH_URL=
FADEREACH_API_KEY=
BRIDGE_TIMEOUT=5

# LemonSqueezy. Configure a real store and variant IDs before enabling checkout.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=247127
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_STARTER_VARIANT_ID=
LS_BUSINESS_VARIANT_ID=
LS_ENTERPRISE_VARIANT_ID=
LS_CHECKOUT_BASE_URL=

# Clerk — JWT/JWKS validation settings will be added in the authentication phase.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

RESILIENCE_WARN_THRESHOLD=60
RESILIENCE_CRITICAL_THRESHOLD=40
PREDICTION_HORIZON_HOURS=72
