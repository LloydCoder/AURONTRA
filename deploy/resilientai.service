# ═══════════════════════════════════════════════════════════════════
# ResilientAI systemd service unit
# Copy to: /etc/systemd/system/resilientai.service
# Then: sudo systemctl daemon-reload && sudo systemctl enable resilientai
# ═══════════════════════════════════════════════════════════════════
[Unit]
Description=ResilientAI — Proactive IT Resilience SaaS
Documentation=https://github.com/Tinlance/resilientai
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tinlance/resilientai/backend
EnvironmentFile=/opt/tinlance/resilientai/.env
ExecStart=/opt/tinlance/resilientai/.venv/bin/uvicorn main:app \
    --host 127.0.0.1 \
    --port 8003 \
    --workers 2 \
    --log-level info \
    --access-log
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=resilientai
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
